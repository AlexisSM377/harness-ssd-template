#!/usr/bin/env bash
set -euo pipefail

feature="${1:-}"
feature_status="${2:-}"

fail() {
  printf "Feature '%s': %s\n" "$feature" "$1" >&2
  exit 1
}

if [ -z "$feature" ] || {
  [ "$feature_status" != "spec_ready" ] &&
    [ "$feature_status" != "in_progress" ] &&
    [ "$feature_status" != "done" ]
}; then
  printf 'Uso: %s <feature> <spec_ready|in_progress|done>\n' "$0" >&2
  exit 2
fi

requirements_file="specs/${feature}/requirements.md"
[ -f "$requirements_file" ] ||
  fail "falta ${requirements_file}"

frontmatter_status="$(
  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && /^status:[[:space:]]*/ {
      sub(/^status:[[:space:]]*/, "")
      sub(/[[:space:]]*#.*/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }
  ' "$requirements_file"
)"

[ "$frontmatter_status" = "approved" ] ||
  fail "${requirements_file} debe tener status: approved en el frontmatter"

grep -Eq \
  '^[[:space:]]*-[[:space:]]*\[[xX]\][[:space:]]+Aprobado por humano[[:space:]]+\(fecha:[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}\)' \
  "$requirements_file" ||
  fail "${requirements_file} necesita la aprobación humana marcada con fecha YYYY-MM-DD"

if [ "$feature_status" != "done" ]; then
  exit 0
fi

traceability_file="specs/${feature}/traceability.md"
[ -f "$traceability_file" ] ||
  fail "falta ${traceability_file}"

requirement_ids="$(
  sed -n \
    's/^[[:space:]]*-[[:space:]]*\*\*\(R[0-9][0-9]*\)\*\*:.*/\1/p' \
    "$requirements_file" |
    sort -u
)"
traceability_ids="$(
  sed -n \
    's/^|[[:space:]]*\(R[0-9][0-9]*\)[[:space:]]*|.*/\1/p' \
    "$traceability_file" |
    sort -u
)"

[ -n "$requirement_ids" ] ||
  fail "${requirements_file} no contiene requisitos R<n>"

[ "$requirement_ids" = "$traceability_ids" ] ||
  fail "${traceability_file} debe tener exactamente una fila por cada requisito"

awk -F '|' '
  function trim(value) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
    return value
  }

  {
    requirement = trim($2)
    if (requirement ~ /^R[0-9]+$/) {
      test_ref = trim($3)
      commit_ref = trim($4)
      if (test_ref == "" ||
          commit_ref == "" ||
          tolower(test_ref) == "pendiente" ||
          tolower(commit_ref) == "pendiente") {
        printf "%s tiene test o commit pendiente para %s\n", FILENAME, requirement > "/dev/stderr"
        invalid = 1
      }
    }
  }

  END { exit invalid }
' "$traceability_file" ||
  fail "${traceability_file} tiene filas incompletas"
